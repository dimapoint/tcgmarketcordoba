# ── Platform-specific Flutter targets (not needed for web build) ───────────
android/
ios/
linux/
macos/
windows/

# ── Supabase migrations / seeds (not needed in image) ───────────────────
supabase/

# ── Test files ───────────────────────────────────────────────────────────
test/

# ── Version control ───────────────────────────────────────────────────────────
.git
.github
.gitignore

# ── IDE / tooling ─────────────────────────────────────────────────────────────
.idea
.vscode
*.swp

# ── Flutter / Dart ────────────────────────────────────────────────────────────
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
build/

# ── Go ────────────────────────────────────────────────────────────────────────
# (nothing to exclude — go.sum must be present for reproducible builds)

# ── Secrets — never bake into images ──────────────────────────────────────────
.env
backend/.env
**/.env

# ── Docs / misc ───────────────────────────────────────────────────────────────
*.md
docs/
*.log
*.ps1

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Docker ────────────────────────────────────────────────────────────────────
docker-compose*.yml
Dockerfile*
