PORT=8080
DATABASE_URL=postgresql://postgres:TU_PASSWORD@TU_HOST:5432/railway
JWT_SECRET=generar-64-chars-aleatorios
# Bucket S3-compatible (Railway Object Storage: `railway bucket credentials`)
S3_ENDPOINT=t3.storageapi.dev
S3_ACCESS_KEY=access-key-del-bucket
S3_SECRET_KEY=secret-key-del-bucket
S3_BUCKET=nombre-del-bucket
RIOT_API_KEY=key-de-developer.riotgames.com
# Base absoluta para og:image/og:url de los previews (sin barra final)
PUBLIC_URL=http://localhost:8080
# OAuth client ID de tipo "Web application" (Google Cloud Console > Credentials).
# Si está vacío, POST /auth/google responde 503 y el botón no aparece en la app.
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
